{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "out/**", ".next/**", "public/r/**"]
        },
        "build:registry": {
            "outputs": ["public/r/**", "../../apps/docs/public/r/**"]
        },
        "typecheck": {
            "cache": true
        },
        "test": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "cache": true
        },
        "format": {
            "cache": true
        }
    }
}
