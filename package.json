{
    "name": "tui",
    "type": "module",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/phasehumans/tui"
    },
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build": "turbo run build",
        "build:registry": "turbo run build:registry",
        "typecheck": "turbo run typecheck",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "release": "bun scripts/release.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "prettier": "^3.5.3",
        "turbo": "^2.4.4",
        "typescript": "^5.8.2"
    },
    "version": "0.0.1"
}
