{
    "name": "@trydecember/tui",
    "version": "0.0.3",
    "description": "a ui library for terminal agents.",
    "homepage": "https://tui.trydecember.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/phasehumans/tui",
        "directory": "apps/cli"
    },
    "bugs": {
        "url": "https://github.com/phasehumans/tui/issues"
    },
    "module": "src/index.ts",
    "type": "module",
    "private": false,
    "author": "Chaitanya Sonawane <team@trydecember.com>",
    "license": "MIT",
    "keywords": [
        "tui"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js",
    "bin": {
        "tui": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "bun build ./src/index.ts --target=node --outfile=./dist/index.js",
        "prepublishOnly": "bun run build",
        "dev": "bun run --watch ./src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "bun test"
    },
    "dependencies": {
        "@clack/prompts": "^0.11.0",
        "picocolors": "^1.1.1"
    },
    "devDependencies": {
        "@types/node": "^22.13.9"
    }
}
