{
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "allowJs": true,

        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,

        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,

        "paths": {
            "@trydecember/tui-core": ["./packages/core/src/index.ts"],
            "@trydecember/tui-core/*": ["./packages/core/src/*"],
            "@trydecember/tui-registry": ["./packages/registry/src/index.ts"],
            "@trydecember/tui-registry/*": ["./packages/registry/src/*"]
        },

        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false
    }
}
